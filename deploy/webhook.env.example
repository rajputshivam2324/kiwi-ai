# Copy to /opt/kiwi/webhook.env on EC2
# systemd loads this at service start — restart after editing:
#   sudo systemctl restart kiwi-deploy-webhook

# Must match GitHub secret BACKEND_DEPLOY_WEBHOOK_SECRET
# (different name, same value)
DEPLOY_WEBHOOK_SECRET=replace_with_long_random_secret

# Image published by GitHub Actions (required for docker compose pull)
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/kiwi-ai-backend:latest

# --- GHCR pull credentials ----------------------------------------------------
# Packages published by GitHub Actions are PRIVATE by default, and an
# unauthenticated `docker compose pull` then fails with "denied"/"unauthorized",
# which the webhook reports as a compose_pull error.
#
# Note that `docker login` credentials are per-user: logging in as `ubuntu` does
# nothing for the webhook, which systemd runs as root. Setting these makes the
# webhook log in itself, as whichever user it runs as.
#
# Either make the package public (GitHub > Packages > Package settings), or set
# these to a PAT with the read:packages scope.
GHCR_USERNAME=YOUR_GITHUB_USERNAME
GHCR_TOKEN=replace_with_pat_with_read_packages_scope

# --- Host asset sync ----------------------------------------------------------
# The Docker image only contains backend/. Set DEPLOY_REPO_URL and the webhook
# will refresh /opt/kiwi from deploy/ in git on every deploy, so pushing also
# updates the compose file, helper scripts and the webhook itself.
#
# Leave empty to disable (assets stay whatever you last copied by hand).
# Private repo: use https://USERNAME:PAT@github.com/OWNER/REPO.git
DEPLOY_REPO_URL=https://github.com/YOUR_GITHUB_USERNAME/kiwi-ai.git
DEPLOY_REPO_BRANCH=main

# Overwrite the installed nginx site configs from deploy/nginx/ too.
# Off by default: certbot rewrites those files, so replacing them can break TLS.
# The sync runs `nginx -t` and rolls back on failure, but review the repo copies
# before enabling this.
DEPLOY_SYNC_NGINX=0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_password
