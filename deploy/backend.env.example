# Copy to /opt/kiwi/backend.env on EC2 and fill real values.
# Do NOT commit real secrets.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kiwi_ai

GEMINI_API_KEY=your_gemini_api_key
# or: GOOGLE_API_KEY=...

CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_JWKS_URL=https://YOUR_CLERK_DOMAIN/.well-known/jwks.json
CLERK_DEV_BYPASS=false

# Frontend domain on Vercel
CORS_ORIGINS=https://kiwiai.shivamio.in

ENVIRONMENT=production
FINANCE_ENABLED=false

# Required for reverse-proxied live preview
BUILDER_MAX_LIVE_PREVIEWS=1
PREVIEW_PORT_START=5200
PREVIEW_ALLOWED_HOSTS=preview.kiwiai.shivamio.in,localhost,127.0.0.1
WORKSPACE_DIR=/app/workspaces

# Research (persisted in the backend_chroma volume)
CHROMA_DB_PATH=/app/data/chroma_db
COLLECTION_NAME=arxiv_papers
EMBEDDING_MODEL=gemini-embedding-001
RAG_CHILD_TOKENS=350
RAG_CHILD_OVERLAP=50
RAG_PARENT_TOKENS=1200
RAG_EMBEDDING_BATCH_SIZE=32
RAG_CANDIDATE_COUNT=30
RAG_CONTEXT_TOKENS=6000
RAG_MAX_PDF_BYTES=52428800
RAG_MAX_PDF_PAGES=1000
# Docker includes English Tesseract. Enable OCR for scanned PDFs.
RAG_OCR_ENABLED=false
RAG_OCR_LANGUAGE=eng

# RAG passages, revisions, memory, and cache registry use DATABASE_URL above.
POSTGRES_POOL_SIZE=4
MEMORY_CONTEXT_TOKENS=4000
MEMORY_SUMMARY_TOKENS=800
MEMORY_RECENT_MESSAGES=8
MEMORY_COMPACTION_BATCH=40
MEMORY_MAX_COMPACTION_BATCHES=3
MEMORY_TURN_TIMEOUT_SECONDS=600
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL_SECONDS=600
PROMPT_CACHE_MIN_TOKENS=1024
PROMPT_CACHE_MAX_TOKENS=32000

# Set true after installing your project's keys here. Never commit real keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_SAMPLE_RATE=1.0
