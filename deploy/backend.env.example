# Copy to /opt/kiwi/backend.env on EC2 and fill real values.
# Do NOT commit real secrets.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kiwi_ai

GEMINI_API_KEY=your_gemini_api_key
# or: GOOGLE_API_KEY=...

CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_JWKS_URL=https://YOUR_CLERK_DOMAIN/.well-known/jwks.json
CLERK_DEV_BYPASS=false

# Frontend domain on Vercel
CORS_ORIGINS=https://kiwiai.shivamio.in

ENVIRONMENT=production
FINANCE_ENABLED=false

# Required for reverse-proxied live preview
BUILDER_MAX_LIVE_PREVIEWS=1
PREVIEW_PORT_START=5200
PREVIEW_ALLOWED_HOSTS=preview.kiwiai.shivamio.in,localhost,127.0.0.1
WORKSPACE_DIR=/app/workspaces
