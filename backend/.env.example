# Shared
GEMINI_API_KEY=
# or GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MAX_RETRIES=8
GEMINI_BACKOFF_INITIAL_MS=1500
GEMINI_BACKOFF_MAX_MS=120000
GEMINI_TOOL_ROUND_DELAY_MS=600

DATABASE_URL=postgresql://kiwi:kiwi_secret_2024@localhost:5432/kiwi_ai

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Production: https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=
# Local only — skip JWT signature verify
CLERK_DEV_BYPASS=false

# Research
CHROMA_DB_PATH=./data/chroma_db
COLLECTION_NAME=arxiv_papers
EMBEDDING_MODEL=gemini-embedding-001

# Advanced RAG (sizes use cl100k_base tokens as a local budget estimate)
RAG_CHILD_TOKENS=350
RAG_CHILD_OVERLAP=50
RAG_PARENT_TOKENS=1200
RAG_EMBEDDING_BATCH_SIZE=32
RAG_CANDIDATE_COUNT=30
RAG_CONTEXT_TOKENS=6000
RAG_MAX_PDF_BYTES=52428800
RAG_MAX_PDF_PAGES=1000
# Enable for scans. Docker includes English Tesseract; local installs need it.
RAG_OCR_ENABLED=false
RAG_OCR_LANGUAGE=eng

# Langfuse Cloud or your self-hosted Langfuse v4 instance (Python SDK v5)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Opt in to sending prompts, answers, and retrieved text to Langfuse.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_SAMPLE_RATE=1.0

# Builder (Postgres = durable source; disk workspaces = disposable)
WORKSPACE_DIR=./workspaces
BUILDER_MAX_FIX_ROUNDS=2
# Concurrent live Vite previews (budget: keep at 1 on small VMs)
BUILDER_MAX_LIVE_PREVIEWS=1
# Stop Vite + wipe disk after idle (source stays in Postgres)
BUILDER_IDLE_EVICT_SECONDS=900
BUILDER_IDLE_SWEEP_SECONDS=60
PREVIEW_PORT_START=5200
PREVIEW_ALLOWED_HOSTS=preview.kiwiai.shivamio.in,localhost,127.0.0.1

# Groww MCP
MCP_COMMAND=npx
MCP_ARGS=-y,mcp-remote,https://mcp.groww.in/mcp
MCP_USE_STUB_TOOLS=false

# Server
ENVIRONMENT=development
FINANCE_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
